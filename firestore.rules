rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;

      match /activities/{activityId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /following/{userId}/list/{targetId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /followers/{userId}/list/{followerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if request.auth.uid == userId || request.auth.uid == followerId;
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
        (request.auth.uid == userId || request.auth.uid == request.resource.data.fromUid);
      allow update, delete: if isOwner(userId);
    }

    match /streaks/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}

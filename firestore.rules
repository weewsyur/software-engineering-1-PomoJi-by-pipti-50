rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMutualConnection(userId) {
      return isSignedIn() && (
        isOwner(userId) ||
        (
          exists(/databases/$(database)/documents/following/$(userId)/list/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/following/$(request.auth.uid)/list/$(userId))
        )
      );
    }

    function validNameFields(data) {
      return (!("firstName" in data) || data.firstName == null || data.firstName is string) &&
        (!("lastName" in data) || data.lastName == null || data.lastName is string) &&
        (!("middleName" in data) || data.middleName == null || data.middleName is string) &&
        (!("suffix" in data) || data.suffix == null || data.suffix is string);
    }

    function validPublicProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(["uid", "displayName", "username", "photoUrl"]) &&
        data.uid == userId &&
        (!("displayName" in data) ||
          (data.displayName is string && !data.displayName.matches('.*@.*'))) &&
        data.username is string &&
        !data.username.matches('.*@.*') &&
        (!("photoUrl" in data) || data.photoUrl == null || data.photoUrl is string) &&
        validNameFields(data);
    }

    // Includes "dassConsent", "dassConsentAt" (consent flag for DASS-21)
    function validUserDocument(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
        "uid", "email", "fullName", "displayName", "username", "firstName",
        "lastName", "middleName", "suffix", "photoUrl", "photoURL",
        "createdAt", "updatedAt",
        "dassConsent", "dassConsentAt"
      ]) &&
        data.uid == userId &&
        (!("createdAt" in data) || data.createdAt is timestamp) &&
        (!("fullName" in data) ||
          (data.fullName is string && !data.fullName.matches('.*@.*'))) &&
        (!("displayName" in data) ||
          (data.displayName is string && !data.displayName.matches('.*@.*'))) &&
        data.username is string &&
        (data.email == null || data.email is string) &&
        validNameFields(data) &&
        (!("photoUrl" in data) || data.photoUrl == null || data.photoUrl is string) &&
        (!("photoURL" in data) || data.photoURL == null || data.photoURL is string) &&
        (!("updatedAt" in data) || data.updatedAt is timestamp) &&
        (!("dassConsent" in data) || data.dassConsent is bool) &&
        (!("dassConsentAt" in data) || data.dassConsentAt is timestamp);
    }

    function validNewUserDocument(userId) {
      let data = request.resource.data;
      return validUserDocument(userId) &&
        data.email is string &&
        data.email.size() > 0 &&
        data.firstName is string &&
        data.firstName.size() > 0 &&
        data.lastName is string &&
        data.lastName.size() > 0 &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.username is string &&
        data.username.size() > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        "photoURL" in data;
    }

    function validActivity(userId) {
      let data = request.resource.data;
      return data.title is string &&
        data.title.size() > 0 &&
        data.sessions is int &&
        data.sessions >= 0 &&
        (
          (
            data.keys().hasOnly([
              "title", "description", "sessions", "totalTime", "images",
              "category", "createdAt", "uid"
            ]) &&
            "uid" in data &&
            data.uid == userId &&
            data.totalTime is number &&
            data.totalTime >= 0 &&
            data.description is string &&
            data.category in ["work", "study", "personal", "health", "other"] &&
            data.images is list &&
            data.images.size() <= 5 &&
            data.createdAt is string
          ) ||
          (
            data.keys().hasOnly([
              "title", "sessions", "totalMinutes", "timestamp", "date", "userId"
            ]) &&
            "userId" in data &&
            data.userId == userId &&
            data.totalMinutes is number &&
            data.totalMinutes >= 0 &&
            data.timestamp is timestamp &&
            data.date is string
          )
        );
    }

    function validNewTask() {
      let data = request.resource.data;
      return validTask() &&
        data.keys().hasAll([
          "title", "description", "dueDate", "reminderEnabled", "category",
          "completed", "totalTime", "createdAt"
        ]);
    }

    function validTask() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "title", "description", "dueDate", "reminderEnabled", "category",
          "completed", "totalTime", "createdAt", "reminderNotificationId"
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        (!("description" in data) || data.description is string) &&
        (!("dueDate" in data) || data.dueDate is string) &&
        (!("reminderEnabled" in data) || data.reminderEnabled is bool) &&
        (!("category" in data) ||
          data.category in ["work", "study", "personal", "health", "other"]) &&
        (!("completed" in data) || data.completed is bool) &&
        (!("totalTime" in data) || (data.totalTime is number && data.totalTime >= 0)) &&
        (!("createdAt" in data) || data.createdAt is string) &&
        (!("reminderNotificationId" in data) ||
          data.reminderNotificationId == null ||
          data.reminderNotificationId is string);
    }

    // Optional before_mood / distractions / cause_category (old docs without
    // them stay valid). The after-session mood is written via moodRating /
    // moodLabel / moodRecordedAt below.
    function validSession() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "taskTitle", "taskId", "date", "durationMinutes", "mode",
          "completedAt", "moodRating", "moodLabel", "moodRecordedAt",
          "before_mood", "distractions", "cause_category"
        ]) &&
        data.taskTitle is string &&
        (data.taskId == null || data.taskId is string) &&
        data.date is string &&
        data.durationMinutes is number &&
        data.durationMinutes >= 0 &&
        data.mode in ["focus", "short", "long"] &&
        (!("completedAt" in data) || data.completedAt is timestamp) &&
        (
          (!("moodRating" in data) && !("moodLabel" in data) && !("moodRecordedAt" in data)) ||
          (
            data.moodRating in [1, 2, 3, 4, 5] &&
            data.moodLabel in ["Very Bad", "Bad", "Okay", "Good", "Great"] &&
            data.moodRecordedAt is timestamp
          )
        ) &&
        (!("before_mood" in data) ||
          (data.before_mood is int && data.before_mood >= 1 && data.before_mood <= 5)) &&
        (!("distractions" in data) ||
          (data.distractions is list && data.distractions.size() <= 10)) &&
        (!("cause_category" in data) ||
          (data.cause_category is string && data.cause_category.size() <= 40));
    }

    function validStats(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "userId", "totalActivities", "totalFocusMinutes", "lastUpdated"
        ]) &&
        data.userId == userId &&
        data.totalActivities is int &&
        data.totalActivities >= 0 &&
        data.totalFocusMinutes is number &&
        data.totalFocusMinutes >= 0 &&
        data.lastUpdated is timestamp;
    }

    function validStreak(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "userId", "currentStreak", "highestStreak", "lastActiveDate",
          "timezone", "createdAt", "updatedAt", "longestStreak",
          "lastActivityDate", "totalActivities"
        ]) &&
        data.userId == userId &&
        (!("currentStreak" in data) ||
          (data.currentStreak is int && data.currentStreak >= 0)) &&
        (!("highestStreak" in data) ||
          (data.highestStreak is int && data.highestStreak >= 0)) &&
        (!("longestStreak" in data) ||
          (data.longestStreak is int && data.longestStreak >= 0)) &&
        (!("totalActivities" in data) ||
          (data.totalActivities is int && data.totalActivities >= 0)) &&
        (!("lastActiveDate" in data) ||
          data.lastActiveDate == null || data.lastActiveDate is timestamp) &&
        (!("lastActivityDate" in data) ||
          data.lastActivityDate == null || data.lastActivityDate is timestamp) &&
        (!("timezone" in data) || data.timezone is string) &&
        (!("createdAt" in data) || data.createdAt is timestamp) &&
        (!("updatedAt" in data) || data.updatedAt is timestamp);
    }

    function validRootActivity(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "userId", "type", "duration", "completedAt", "createdAt",
          "updatedAt", "tags"
        ]) &&
        data.userId == userId &&
        data.type in ["pomodoro", "break", "focus"] &&
        data.duration is number &&
        data.duration >= 0 &&
        data.createdAt is timestamp &&
        (!("completedAt" in data) || data.completedAt is timestamp) &&
        (!("updatedAt" in data) || data.updatedAt is timestamp) &&
        (!("tags" in data) || (data.tags is list && data.tags.size() <= 20));
    }

    function validConnection(data) {
      return data.keys().hasOnly(["username", "createdAt"]) &&
        data.username is string &&
        !data.username.matches('.*@.*') &&
        data.createdAt is timestamp;
    }

    function validFollowNotification(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "type", "fromUid", "fromUsername", "read", "createdAt"
        ]) &&
        data.type == "follow" &&
        data.fromUid == request.auth.uid &&
        data.fromUsername is string &&
        !data.fromUsername.matches('.*@.*') &&
        data.read == false &&
        data.createdAt is timestamp &&
        existsAfter(/databases/$(database)/documents/following/$(request.auth.uid)/list/$(userId)) &&
        existsAfter(/databases/$(database)/documents/followers/$(userId)/list/$(request.auth.uid));
    }

    function validOwnNotification(userId) {
      let data = request.resource.data;
      return isOwner(userId) && (
        (
          data.type == "task_reminder" &&
          data.keys().hasOnly([
            "type", "taskId", "taskTitle", "dueDate", "reminderStatus", "read", "createdAt"
          ]) &&
          data.taskId is string &&
          data.taskTitle is string &&
          data.dueDate is string &&
          data.reminderStatus in ["upcoming", "overdue"]
        ) ||
        (
          data.type == "session_complete" &&
          data.keys().hasOnly([
            "type", "taskId", "taskTitle", "durationSeconds",
            "sessionsCompleted", "read", "createdAt"
          ]) &&
          (data.taskId == null || data.taskId is string) &&
          data.taskTitle is string &&
          data.durationSeconds is number &&
          data.durationSeconds >= 0 &&
          data.sessionsCompleted is int &&
          data.sessionsCompleted >= 0
        )
      ) &&
      data.read == false &&
      data.createdAt is timestamp;
    }

    // ---- DASS-21 helpers ----
    function pad2(n) {
      return (n < 10 ? '0' : '') + string(n);
    }

    // UTC calendar date of a timestamp, as YYYY-MM-DD
    function ymd(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    // The student's LOCAL date differs from the UTC date by at most 1 day.
    function dateNearNow(d) {
      return d in [
        ymd(request.time - duration.value(1, 'd')),
        ymd(request.time),
        ymd(request.time + duration.value(1, 'd'))
      ];
    }

    function validSeverity(s) {
      return s in ["normal", "mild", "moderate", "severe", "extremely_severe"];
    }

    // Scores are (sum of 7 items) * 2, so they are even integers 0..42
    function validDassScore(n) {
      return n is int && n >= 0 && n <= 42 && n % 2 == 0;
    }

    function validDassResult(userId, docId) {
      let d = request.resource.data;
      let keys = [
        "user_id", "date",
        "depression_score", "anxiety_score", "stress_score",
        "depression_severity", "anxiety_severity", "stress_severity",
        "responses", "questionnaire_version", "consent_given", "createdAt"
      ];
      return d.keys().hasOnly(keys) &&
        d.keys().hasAll(keys) &&
        d.user_id == userId &&
        d.date is string &&
        d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        docId == d.date &&
        dateNearNow(d.date) &&
        validDassScore(d.depression_score) &&
        validDassScore(d.anxiety_score) &&
        validDassScore(d.stress_score) &&
        validSeverity(d.depression_severity) &&
        validSeverity(d.anxiety_severity) &&
        validSeverity(d.stress_severity) &&
        d.responses is list && d.responses.size() == 21 &&
        d.questionnaire_version is string && d.questionnaire_version.size() <= 20 &&
        d.consent_given == true &&
        d.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validNewUserDocument(userId);
      allow update: if isOwner(userId) &&
        validUserDocument(userId) &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // DASS-21 results: users/{uid}/dass21_assessments/{YYYY-MM-DD}, one doc
      // per local day, id = date. Private to the owner; create-only.
      match /dass21_assessments/{docId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          !exists(/databases/$(database)/documents/users/$(userId)/dass21_assessments/$(docId)) &&
          validDassResult(userId, docId);
        allow update, delete: if false; // no client edits/deletes (prevents retake-by-delete)
      }

      match /activities/{activityId} {
        allow read: if isMutualConnection(userId);
        allow create: if isOwner(userId) && validActivity(userId);
        allow update: if isOwner(userId) &&
          validActivity(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "description", "sessions", "totalTime", "images", "category"
          ]);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validSession();
        allow update: if isOwner(userId) &&
          validSession() &&
          !("moodRating" in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "moodRating", "moodLabel", "moodRecordedAt"
          ]);
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validNewTask();
        allow update: if isOwner(userId) &&
          validTask() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "description", "dueDate", "reminderEnabled", "category",
            "completed", "totalTime", "reminderNotificationId"
          ]);
      }

      match /stats/{statsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          statsId == "overall" &&
          validStats(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && validPublicProfile(userId);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) &&
        validRootActivity(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.userId == resource.data.userId &&
        validRootActivity(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "type", "duration", "completedAt", "updatedAt", "tags"
        ]);
      allow delete: if isOwner(resource.data.userId);
    }

    match /following/{userId}/list/{targetId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) &&
        targetId != userId &&
        validConnection(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /followers/{userId}/list/{followerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.auth.uid == followerId &&
        userId != followerId &&
        validConnection(request.resource.data) &&
        existsAfter(/databases/$(database)/documents/following/$(followerId)/list/$(userId));
      allow delete: if isOwner(userId) ||
        (isSignedIn() && request.auth.uid == followerId);
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId);
      allow create: if validOwnNotification(userId) ||
        (isSignedIn() && validFollowNotification(userId));
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]) &&
        request.resource.data.read is bool;
      allow delete: if isOwner(userId);
    }

    match /streaks/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validStreak(userId);
      allow update: if isOwner(userId) &&
        validStreak(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentStreak", "highestStreak", "lastActiveDate", "timezone",
          "updatedAt", "longestStreak", "lastActivityDate",
          "totalActivities"
        ]);
      allow delete: if isOwner(userId);
    }
  }
}

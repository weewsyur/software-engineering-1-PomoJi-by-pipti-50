{
  "expo": {
    "name": "PomoJI",
    "slug": "pomoji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/POMOJI.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/POMOJI.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pomoji.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/POMOJI.png",
        "backgroundImage": "./assets/images/POMOJI.png",
        "monochromeImage": "./assets/images/POMOJI.png"
      },
      "package": "com.pomoji.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/POMOJI.png",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover",
        "theme-color": "#ef4444",
        "description": "A powerful Pomodoro timer app with Firebase sync, offline support, and strict focus mode to boost productivity",
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "default",
        "apple-mobile-web-app-title": "PomoJI"
      },
      "manifest": {
        "name": "PomoJI - A Productivity & Progress Monitoring App",
        "short_name": "PomoJI",
        "description": "A powerful Pomodoro timer app with Firebase sync, offline support, and strict focus mode to boost productivity",
        "start_url": "/",
        "scope": "/",
        "display": "standalone",
        "theme_color": "#ef4444",
        "background_color": "#ffffff",
        "orientation": "portrait-primary",
        "categories": [
          "productivity",
          "utilities"
        ],
        "icons": [
          {
            "src": "POMOJI.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/POMOJI.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
          },
          {
            "src": "/POMOJI.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/POMOJI.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
          }
        ],
        "shortcuts": [
          {
            "name": "Start Focus Session",
            "short_name": "Focus",
            "description": "Start a 25-minute focus session",
            "url": "/timer?mode=focus",
            "icons": [
              {
                "src": "/POMOJI.png",
                "sizes": "192x192",
                "type": "image/png"
              }
            ]
          },
          {
            "name": "View Tasks",
            "short_name": "Tasks",
            "description": "View and manage your tasks",
            "url": "/home",
            "icons": [
              {
                "src": "/icon-192x192.png",
                "sizes": "192x192",
                "type": "image/png"
              }
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbf5e421-0103-41a6-81ee-18eedd072c0d"
      }
    }
  }
}

    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "feather-icons": "^4.29.2",
    "firebase": "^12.12.1",
    "idb": "^8.0.0",
    "lucide-react-native": "^1.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",

    "@types/react": "~18.3.12",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.0",
    "eslint": "~8.57.1",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "nativewind": "^4.2.3",
    "postcss": "^8.5.10",
    "query-string": "^7.1.3",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.3",

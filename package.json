    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.0.14",
    "expo": "^52.0.49",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
